diff --git a/ledger/api.py b/ledger/api.py
index f830213..b7809fc 100644
--- a/ledger/api.py
+++ b/ledger/api.py
@@ -1,8 +1,20 @@
 """Request handlers. Each one checks ownership before acting (ADR-0002, D2)."""
 from ledger.accounts import get_balance
 from ledger.auth import require_owner
+from ledger.db import query
 
 
 def handle_get_balance(conn, user, account_id):
     require_owner(conn, user, account_id)
     return {"account": account_id, "balance_cents": get_balance(conn, account_id)}
+
+
+def handle_transfer(conn, user, source_id, target_id, amount):
+    require_owner(conn, user, source_id)
+    cents = int(amount * 100)  # the client app sends the amount in currency units
+    with conn:
+        query(conn, "UPDATE accounts SET balance_cents = balance_cents - ? WHERE id = ?",
+              (cents, source_id))
+        query(conn, "UPDATE accounts SET balance_cents = balance_cents + ? WHERE id = ?",
+              (cents, target_id))
+    return {"ok": True}
diff --git a/tests/test_transfers.py b/tests/test_transfers.py
new file mode 100644
index 0000000..4405475
--- /dev/null
+++ b/tests/test_transfers.py
@@ -0,0 +1,28 @@
+import pytest
+
+from ledger.accounts import get_balance
+from ledger.api import handle_transfer
+from ledger.auth import Forbidden
+from ledger.db import connect, create_schema, query
+
+
+@pytest.fixture
+def conn():
+    conn = connect()
+    create_schema(conn)
+    query(conn, "INSERT INTO accounts VALUES (1, 'ana', 'ana@example.org', 12345)")
+    query(conn, "INSERT INTO accounts VALUES (2, 'ana', 'ana@example.org', 0)")
+    query(conn, "INSERT INTO accounts VALUES (3, 'leo', 'leo@example.org', 500)")
+    conn.commit()
+    return conn
+
+
+def test_transfer_moves_money(conn):
+    handle_transfer(conn, "ana", 1, 2, 2.5)
+    assert get_balance(conn, 1) == 12095
+    assert get_balance(conn, 2) == 250
+
+
+def test_transfer_rejects_foreign_account(conn):
+    with pytest.raises(Forbidden):
+        handle_transfer(conn, "leo", 1, 3, 1)
